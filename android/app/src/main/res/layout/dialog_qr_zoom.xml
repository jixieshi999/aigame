<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/card_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvZoomTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="扫码加入联机房间"
        android:textColor="@color/bone_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvZoomSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="其他手机浏览器扫码即可直接加入游戏"
        android:textColor="@color/steel_muted"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/ivZoomQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:contentDescription="Large QR Code" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvZoomUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="http://..."
        android:textColor="@color/signal_amber"
        android:textSize="12sp"
        android:gravity="center"
        android:textIsSelectable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomCopy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="复制链接"
            android:textColor="@color/signal_amber"
            app:strokeColor="@color/signal_amber" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="关闭"
            android:textColor="@color/bg_dark"
            app:backgroundTint="@color/signal_amber" />
    </LinearLayout>
</LinearLayout>
